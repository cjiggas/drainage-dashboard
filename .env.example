# Copy this file to .env and fill in the values.

# Claude API key from https://platform.claude.com (keep it secret)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Shared password between the ESP32 and this server.
# Put the SAME value in DEVICE_KEY in the ESP32 sketch.
DEVICE_KEY=change-me-to-something-random

# Automatic AI check every N seconds while the device is online (0 = only when you press the button)
AI_INTERVAL_SECONDS=30

# Port for local use
PORT=3000
